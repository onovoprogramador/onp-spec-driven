{
  "name": "@onovoprogramador/onp-spec",
  "version": "0.10.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Spec-anchored development: specs auditáveis contra o código, DoD executável, suposições explícitas e constituição verificável. Zero dependências.",
  "type": "module",
  "bin": {
    "onp-spec": "bin/onp-spec.js"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build-skill.mjs",
    "test": "node tools/test.mjs",
    "bench": "node benchmark/run.js",
    "release:check": "node tools/check-release.mjs",
    "prepack": "node tools/build-skill.mjs --quiet",
    "prepublishOnly": "npm run release:check",
    "bench:performance": "node benchmark/performance.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "skills/",
    "docs/GUIA-DE-INTEGRACOES.md",
    "docs/ATUALIZACOES-0.10.0.svg",
    "docs/ATUALIZACOES-0.10.0.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "spec-driven",
    "spec-anchored",
    "sdd",
    "rastreabilidade",
    "lgpd",
    "ai-coding",
    "developer-tools",
    "requirements",
    "automation",
    "worktrees"
  ],
  "author": "Vitor Manoel — O Novo Programador",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onovoprogramador/onp-spec-driven.git"
  },
  "homepage": "https://github.com/onovoprogramador/onp-spec-driven#readme",
  "bugs": {
    "url": "https://github.com/onovoprogramador/onp-spec-driven/issues"
  },
  "license": "MIT"
}
